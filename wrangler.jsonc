{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ca-commongrants-api",
  "main": "src/index.ts",
  // Latest stable compatibility date at time of scaffolding. See:
  // https://developers.cloudflare.com/workers/configuration/compatibility-dates/
  "compatibility_date": "2026-03-20",
  "compatibility_flags": ["nodejs_compat"],
  // Naming convention: {state}-grants-{purpose}. Encodes state + data domain +
  // purpose, avoids collisions with other D1/R2 resources in the same CF
  // account when this template is forked for other states (e.g. pa-grants-*).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ca-grants-commongrants",
      "database_id": "587439a4-80df-41a8-a135-fa37a7e9336c",
      "migrations_dir": "src/storage/sql/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "ca-grants-raw-snapshots",
    },
  ],
  "triggers": {
    // Sync every 8 hours. California's Grants Portal refreshes roughly once a
    // day; running 3×/day means a missed update window or a transient failure
    // is retried well within 24h. Syncs are incremental (watermark-based), so
    // each run only fetches the changed delta.
    "crons": ["0 */8 * * *"],
  },
  "vars": {
    // CKAN action API base + the grants DataStore resource id. The client
    // builds `datastore_search` requests from these.
    "CA_API_BASE_URL": "https://data.ca.gov/api/3/action",
    "CA_RESOURCE_ID": "111c8c88-21f6-453c-ae2c-b4785a0624f5",
    "ENVIRONMENT": "production",
  },
  "observability": {
    "enabled": true,
  },

  // Preview environment — used by CI preview deploys (PRs).
  // D1 database is ephemeral: created per-PR by cd.yml, torn down on close.
  // The database_id is patched dynamically by the workflow before deploy.
  // R2 bucket is shared (snapshots are append-only / idempotent).
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ca-grants-preview",
          "database_id": "PATCHED_BY_CI",
          "migrations_dir": "src/storage/sql/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "SNAPSHOTS",
          "bucket_name": "ca-grants-raw-snapshots",
        },
      ],
      "vars": {
        "CA_API_BASE_URL": "https://data.ca.gov/api/3/action",
        "CA_RESOURCE_ID": "111c8c88-21f6-453c-ae2c-b4785a0624f5",
        "ENVIRONMENT": "preview",
      },
    },
  },
}
