{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wa-commongrants-api",
  "main": "src/index.ts",
  // Latest stable compatibility date at time of scaffolding. See:
  // https://developers.cloudflare.com/workers/configuration/compatibility-dates/
  "compatibility_date": "2026-03-20",
  "compatibility_flags": ["nodejs_compat"],
  // Naming convention: {state}-grants-{purpose}. Encodes state + data domain +
  // purpose, avoids collisions with other D1/R2 resources in the same CF
  // account when this template is forked for other states (e.g. pa-grants-*).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wa-grants-commongrants",
      // Create with `pnpm run bootstrap` (or `wrangler d1 create
      // wa-grants-commongrants`) and paste the returned uuid here.
      "database_id": "621e23bd-f22d-4ec5-bd27-f20399df1389",
      "migrations_dir": "src/storage/sql/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "wa-grants-raw-snapshots",
    },
  ],
  "triggers": {
    // Sync every 8 hours. Inherited from the CA cadence; revisit once
    // FundHub's actual refresh rate is known. Syncs are incremental
    // (watermark-based), so each run only fetches the changed delta.
    "crons": ["0 */8 * * *"],
  },
  "vars": {
    // FundHub's WordPress REST API base + the resource (post type) the client
    // reads from — https://fundhub.wa.gov/wp-json/wp/v2/funding?per_page=100
    //
    // TODO(adapter): `WaSourceClient` still builds CKAN `datastore_search`
    // requests against these two values. Reshape them as needed when the
    // adapter is ported to the WP REST API.
    "WA_API_BASE_URL": "https://fundhub.wa.gov/wp-json/wp/v2",
    "WA_RESOURCE_ID": "funding",
    "ENVIRONMENT": "production",
  },
  "observability": {
    "enabled": true,
  },

  // Preview environment — used by CI preview deploys (PRs).
  // D1 database is ephemeral: created per-PR by cd.yml, torn down on close.
  // The database_id is patched dynamically by the workflow before deploy.
  // R2 bucket is shared (snapshots are append-only / idempotent).
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wa-grants-preview",
          "database_id": "PATCHED_BY_CI",
          "migrations_dir": "src/storage/sql/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "SNAPSHOTS",
          "bucket_name": "wa-grants-raw-snapshots",
        },
      ],
      "vars": {
        "WA_API_BASE_URL": "https://fundhub.wa.gov/wp-json/wp/v2",
        "WA_RESOURCE_ID": "funding",
        "ENVIRONMENT": "preview",
      },
    },
  },
}
